# Copy this file to .env and fill in your keys. Do not commit .env.

# ── Cloud APIs ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGCHAIN_API_KEY=
# ── HuggingFace ───────────────────────────────────────────────────────────────
# 代码接受 HF_TOKEN / HUGGING_FACE_HUB_TOKEN / HF_API_KEY 任意一个。
# huggingface.co 直连不通时（国内服务器）取消下一行注释走镜像：
# HF_ENDPOINT=https://hf-mirror.com
HF_API_KEY=
TAVILY_API_KEY=

# Optional legacy fallback for web search — Google closed this API to new
# customers in 2025 and will shut it down entirely on January 1, 2027.
# Most new users should leave these blank and use TAVILY_API_KEY above instead.
# See LearningCenter/api-key-guides/google-custom-search.md.
CUSTOM_SEARCH_ENGINE_API_KEY=
CUSTOM_SEARCH_ENGINE_ID=

# ── Grace / vLLM (local chat via SSH tunnel) ──────────────────────────────────
# Only needed if using Grace HPRC local models. See developer_scripts/README.md.
# Do NOT reuse OPENAI_API_KEY here — vLLM uses its own server key (wrong key → 401).
#
# Docker users: use host.docker.internal so the container can reach the SSH
# tunnel running on your host machine (localhost won't work inside Docker).
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_BASE_URL__GRACE_GEMMA_4_31B_FP8=http://host.docker.internal:8002/v1
VLLM_BASE_URL__GRACE_GEMMA_4_26B_A4B_FP8=http://host.docker.internal:8003/v1
VLLM_API_KEY=grace-gemma4-local
# Root directory where Gemma checkpoints are stored on Grace:
GRACE_MODELS_DIR=/scratch/user/your_netid/local_llm/models
# GRACE_SSH_USER=your_netid

# ── RAG embeddings (used when Grace model is active) ─────────────────────────
# local = BAAI/bge-base-en-v1.5, no cloud API required
RADIANT_EMBEDDING_PROVIDER=local
RADIANT_LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RADIANT_LOCAL_EMBEDDING_DEVICE=cpu

# ── Vision-only OpenAI-compatible endpoint (M0 新增) ──────────────────────────
# 视觉解析可独立于对话链路走另一个 OpenAI 兼容端点（如对话用 DeepSeek、视觉用
# 阿里百炼 qwen-vl）。不设则回退到 OPENAI_BASE_URL / OPENAI_API_KEY。
VISUAL_PARSER_OPENAI_BASE_URL=
VISUAL_PARSER_OPENAI_API_KEY=
# 视觉模型名（ParserConfig 已有）：VISUAL_PARSER_GPT_VISION_MODEL=qwen-vl-max
